ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./test.db
OSS_ACCESS_KEY_ID=your-oss-access-key
OSS_SECRET_ACCESS_KEY=your-oss-secret-key
OSS_INTERNAL_ENDPOINT=http://object-storage.objectstorage-system.svc.cluster.local
OSS_EXTERNAL_ENDPOINT=https://objectstorageapi.example.com
OSS_BUCKET_NAME=your-oss-bucket
OSS_REGION=us-east-1
ADMIN_SESSION_SECRET=change-this-secret-to-something-random-32-characters
# ADMIN_COOKIE_SECURE=true
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_USERNAME=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES_PER_SUBMISSION=10
